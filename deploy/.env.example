# Copy to deploy/.env and adjust. Never commit the real .env.

# --- Public ports -------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8010

# Origin the browser uses. Must match the URL you open (scheme + host + port).
CORS_ALLOW_ORIGINS=http://localhost:8080

# --- Data source --------------------------------------------------------------
# mock     -> synthetic data, no database (good for a first smoke test).
# database -> real Home Assistant recorder DB (read-only).
DATA_SOURCE=database

# --- Home Assistant recorder database (only DATA_SOURCE=database) -------------
DB_HOST=172.20.48.17
DB_PORT=3306
DB_NAME=smartesi
DB_USER=admin_db
DB_PASSWORD=change-me
DB_SSL=true
DB_SSL_CA=

# --- Metric factors (optional, defaults are fine) -----------------------------
# ENERGY_PRICE_EUR_PER_KWH=0.20
# CO2_KG_PER_KWH=0.15
# GAS_PRICE_EUR_PER_KWH=0.06
# GAS_CO2_KG_PER_KWH=0.20
# GAS_KWH_PER_M3=10.35
# HEATING_BASE_TEMPERATURE_C=18.0
# USE_STATISTICS_FOR_STATES=true
# STATS_CACHE_TTL_SECONDS=30
# TIMEZONE=Europe/Madrid
