# Copia este fichero a `.env` (`.env` está en .gitignore) y ajusta lo que necesites.
# Con DATA_SOURCE=mock NO se necesita base de datos: los datos son sintéticos.

APP_ENV=development

# "mock"     -> datos sintéticos (por defecto, sin base de datos)
# "database" -> lee de la base de datos real de Home Assistant (requiere pip install -e ".[database]")
DATA_SOURCE=mock

# Factores usados por las gráficas de consumo
ENERGY_PRICE_EUR_PER_KWH=0.20
CO2_KG_PER_KWH=0.15
# Topes de plausibilidad del consumo horario (saltos irreales del contador se ignoran)
ENERGY_MAX_KWH_PER_HOUR=150.0
GAS_MAX_M3_PER_HOUR=50.0
# Gas: precio y factor de emisión (usados por las gráficas de climatización)
GAS_PRICE_EUR_PER_KWH=0.06
GAS_CO2_KG_PER_KWH=0.20
# El contador real de gas mide m³; este factor los pasa a kWh (gas natural ~10,3–11,6 kWh/m³).
GAS_KWH_PER_M3=10.35
# Temperatura base para calcular los grados-día de calefacción
HEATING_BASE_TEMPERATURE_C=18.0
# Usa la tabla statistics (media horaria ya calculada) para temperaturas/humedad.
# Si un sensor no tiene estadísticas, se lee de states automáticamente.
USE_STATISTICS_FOR_STATES=true

# Orígenes permitidos por CORS (el frontend de desarrollo corre en el 5174)
CORS_ALLOW_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

STATS_CACHE_TTL_SECONDS=30
TIMEZONE=Europe/Madrid

# --- Base de datos real (solo se usa cuando DATA_SOURCE=database) -------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartesi
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=true
DB_SSL_CA=
