# Copia este fichero a `.env` y ajusta lo que necesites.
# Con DATA_SOURCE=mock NO se necesita base de datos: los datos son sintéticos.

APP_ENV=development

# "mock"     -> datos sintéticos (sin base de datos)
# "database" -> lee la base de datos real de Home Assistant (requiere pip install -e ".[database]")
DATA_SOURCE=mock

# Factores usados por las gráficas
ENERGY_PRICE_EUR_PER_KWH=0.20
CO2_KG_PER_KWH=0.15
# Tope de plausibilidad del consumo horario (saltos irreales del contador se ignoran)
ENERGY_MAX_KWH_PER_HOUR=150.0

# Orígenes permitidos por CORS (el frontend de desarrollo corre en el 5174)
CORS_ALLOW_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

STATS_CACHE_TTL_SECONDS=30
TIMEZONE=Europe/Madrid

# --- Base de datos real (solo se usa cuando DATA_SOURCE=database) -------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartesi
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=true
DB_SSL_CA=
